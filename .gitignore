# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Jupyter
.ipynb_checkpoints/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Data (raw/processed operational data must not be committed)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/exports/*
!data/exports/.gitkeep

# Model artifacts
artifacts/*
!artifacts/.gitkeep

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db
